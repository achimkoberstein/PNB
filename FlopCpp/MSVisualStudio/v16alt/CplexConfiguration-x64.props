<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <CplexVersion>2220</CplexVersion>
  </PropertyGroup>
  <PropertyGroup>
    <_ProjectFileVersion>11.0.50727.1</_ProjectFileVersion>
    <_PropertySheetDisplayName>CplexConfiguration</_PropertySheetDisplayName>
  </PropertyGroup>

	<Target Name="CheckCplexMacro" BeforeTargets="ClCompile">
		<Message Text="CPLEX_STUDIO_DIR222=$(CPLEX_STUDIO_DIR222)" Importance="High"/>
		<Message Text="USE_CPLEX defined? $(PreprocessorDefinitions)" Importance="High"/>
	</Target>
	
	<ItemDefinitionGroup   Condition="'$(CPLEX_STUDIO_DIR222)' != ''">
		<ClCompile>
			<PreprocessorDefinitions>
				USE_CPLEX;
				%(PreprocessorDefinitions)
			</PreprocessorDefinitions>
    <!--$(CplexVersion) is not supported in ItemDefinitionGroup-->
      <AdditionalIncludeDirectories>
		  $(CPLEX_STUDIO_DIR222)/cplex/include;
		  %(AdditionalIncludeDirectories)
	  </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>
		  cplex2220.lib;
		  %(AdditionalDependencies)
	  </AdditionalDependencies>
      <AdditionalLibraryDirectories>
		  $(CPLEX_STUDIO_DIR222)/cplex/lib/x64_windows_msvc14/stat_mdd;
		  %(AdditionalLibraryDirectories)
	  </AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="CplexVersion">
      <Value>$(CplexVersion)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>