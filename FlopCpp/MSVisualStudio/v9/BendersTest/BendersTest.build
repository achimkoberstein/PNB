
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
<Import Project="..\..\..\..\ThirdParty\msbuildtasks\MSBuild.TeamCity.Tasks.Targets"/>

    <Target Name="MyTarget">
		
	<Exec
		   Command="..\Release\BendersTest.exe --gtest_output=xml:"
		   Timeout="30000"
		   IgnoreExitCode="true"
	/>
	<ImportGoogleTests
		   TestResultsPath="..\Release\BendersTest.xml"
	/>
    </Target>
</Project>