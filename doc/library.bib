@inproceedings{Greenwald2006,
abstract = {The Sample Average Approximation (SAA) method is a technique for approximating solutions to stochastic programs. Here, we attempt to scale up the SAA method to harder problems than those previously studied. We argue that to apply the SAA method effectively, there are three parameters to optimize: the number of evaluations, the number of scenarios, and the number of candidate solutions. We propose an experimental methodology for finding the optimal settings of these parameters given fixed time and space constraints. We apply our methodology to two large-scale stochastic optimization problems that arise in the context of the annual Trading Agent Competition. Both problems are expressed as integer linear programs and solved using CPLEX. Runtime increases linearly with the number of scenarios in one of the problems, and exponentially in the other. We find that, in the former problem, maximizing the number of scenarios yields the best solution, while in the latter problem, it is necessary to evaluate multiple candidate solutions to find the best solution, since increasing the number of scenarios becomes expensive very quickly.},
author = {Greenwald, Amy and Guillemette, Bryan and Naroditskiy, Victor and Tschantz, Michael},
booktitle = {Agent-Mediated Electronic Commerce. Designing Trading Agents and Mechanisms},
doi = {10.1007/11888727\_14},
file = {:C$\backslash$:/Users/wolf/Documents/My Dropbox/Uni/Literatur/Stochastische Programmierung/Approximation Methods/GreenwaldGNT2006-ScalingUpSAAMethodForStochasticOptimization.pdf:pdf},
isbn = {978-3-540-46242-2},
